<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Battlecruiser's privacy manifest. Covers all code in the app binary, including
  the BattlecruiserKit modules, which are linked into it statically.

  Keep it in step with the code:
  - Required-reason APIs: only the file-timestamp category, used by
    ResponseCache (reads and sets modification dates of its own files in Caches/).
  - Collected data: the user's location, sent to the PubDB API as lat/lon to
    work out distances. Not linked to an identity (there are no accounts), not
    used for tracking.
  If the app starts using UserDefaults, sign-in, analytics or anything else that
  sends data off the device, update this file in the same change.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- Timestamps of files inside the app's own container (Caches/ResponseCache). -->
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
